{
  "name": "holonet-trader",
  "version": "0.1.2",
  "description": "Sales and inventory tracker for SWG Legends, built on the game's /mailsave files",
  "main": "./out/main/index.js",
  "author": "HoloNet Trader contributors",
  "license": "MIT",
  "private": true,
  "scripts": {
    "postinstall": "node node_modules/electron/install.js",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dist": "electron-vite build && electron-builder --win"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.3.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "build": {
    "appId": "com.holonettrader.app",
    "productName": "HoloNet Trader",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**"
    ],
    "publish": {
      "provider": "github",
      "owner": "CattyWampus00",
      "repo": "holonet-trader"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.png",
      "artifactName": "HoloNet-Trader-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
